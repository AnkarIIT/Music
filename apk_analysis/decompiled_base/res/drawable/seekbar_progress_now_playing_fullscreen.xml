            <item android:state_pressed="true">
                <scale android:scaleWidth="100%">
                    <shape android:shape="rectangle">
                        <size android:height="2.0dip" />
                        <solid android:color="@color/color_primary" />
                    </shape>
                </scale>
            </item>
            <item>
                <scale android:scaleWidth="100%">
                    <shape android:shape="rectangle">
                        <size android:height="2.0dip" />
                        <solid android:color="@color/color_primary" />
                    </shape>
                </scale>
            </item>
        </selector>
    </item>
</layer-list>
