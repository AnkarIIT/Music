<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="fill_horizontal|center" android:top="10.0dip" android:bottom="10.0dip">
        <shape android:shape="rectangle">
            <size android:height="2.0dip" />
            <solid android:color="@color/system_gray" />
        </shape>
    </item>
    <item android:gravity="fill_horizontal|center" android:id="@id/progress" android:top="10.0dip" android:bottom="10.0dip">
