<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme.DialogFlowDialog" parent="@style/AppTheme.RoundedDialog" />
    <style name="AppTheme.DialogFlowDialog.WindowAnimations" parent="@style/AppTheme.DialogFlowDialog">
        <item name="android:windowEnterAnimation">@android:anim/fade_in</item>
        <item name="android:windowExitAnimation">@android:anim/fade_out</item>
    </style>
    <style name="AppTheme.FullScreenDialog" parent="@style/Theme.AppCompat.Light.NoActionBar">
        <item name="android:backgroundDimAmount">0.42</item>
        <item name="android:windowBackground">@drawable/rounded_background_system_dialog</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:shadowRadius">0.5</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
    </style>
    <style name="ArtistFeaturedReleaseLayoutGravity">
        <item name="android:layout_gravity">center_vertical</item>
    </style>
    <style name="StorePageSheet" parent="@android:style/Theme.DeviceDefault.Dialog">
        <item name="android:backgroundDimAmount">0.42</item>
        <item name="android:windowBackground">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:shadowRadius">0.5</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
    </style>
    <style name="SignInSheet" parent="@style/StorePageSheet">
        <item name="android:windowBackground">@android:drawable/dialog_holo_light_frame</item>
        <item name="android:windowAnimationStyle">@style/UpsellEntryAnimation</item>
        <item name="android:layout_gravity">start</item>
    </style>
    <style name="SignInSheetChromebook" parent="@style/StorePageSheet">
        <item name="android:windowBackground">@android:drawable/dialog_holo_light_frame</item>
        <item name="android:layout_gravity">start</item>
    </style>
    <style name="StorePageFullSheet" parent="@android:style/Theme.Panel">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowTitleStyle">@null</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowSoftInputMode">adjustPan</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="homeAsUpIndicator">@drawable/abc_ic_ab_back_material</item>
    </style>
</resources>
