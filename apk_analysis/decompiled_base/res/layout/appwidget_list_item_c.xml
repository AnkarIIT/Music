<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout style="@style/AppWidgetListItem"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView style="@style/AppWidgetListItemImageView" />
    <LinearLayout android:id="@id/appwidget_list_item_content_metadata" style="@style/AppWidgetListItemContentMetadata">
        <TextView android:ellipsize="end" android:id="@id/appwidget_item_caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" style="@style/AppWidgetCaption2Emphasized" />
        <TextView android:ellipsize="end" android:id="@id/appwidget_item_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" style="@style/AppWidgetSubheadMedium" />
        <TextView android:ellipsize="end" android:id="@id/appwidget_item_subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" style="@style/AppWidgetSubhead" />
    </LinearLayout>
    <include layout="@layout/appwidget_list_item_play_button" />
</RelativeLayout>
