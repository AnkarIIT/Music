            </LinearLayout>
            <ImageView android:id="@id/note" android:layout_width="17.0dip" android:layout_height="21.0dip" android:layout_alignParentTop="true" android:layout_marginStart="4.0dip" android:layout_marginEnd="10.0dip" android:layout_alignParentEnd="true" />
        </LinearLayout>
