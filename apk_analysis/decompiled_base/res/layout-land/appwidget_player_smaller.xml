<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:gravity="start|center" android:id="@id/widget_player_container" android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
